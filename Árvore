# 4. ALGORITMO CART
gini <- function(y) {
  p <- table(y)/length(y)
  g <- 1 - sum(p^2)
  return(g)
}

classe_majoritaria <- function(y) {
  tab <- table(y)
  classe <- names(tab)[which.max(tab)]
  return(classe)
}

melhor_divisao <- function(dados, xvars, yvar) {
  melhor_var   <- NULL
  melhor_corte <- NULL
  melhor_ganho <- -1
  
  y <- dados[[yvar]]
  gini_pai <- gini(y)
  n_total  <- length(y)
  
  for(v in xvars) {
    valores <- sort(unique(dados[[v]]))
    if(length(valores) <= 1) next
    
    cortes <- (valores[-1] + valores[-length(valores)]) / 2
    
    for(c in cortes) {
      esq_idx <- dados[[v]] <= c
      dir_idx <- dados[[v]] > c
      
      y_esq <- y[esq_idx]
      y_dir <- y[dir_idx]
      
      if(length(y_esq) == 0 || length(y_dir) == 0) next
      
      gini_filhos <- (length(y_esq)/n_total)*gini(y_esq) + (length(y_dir)/n_total)*gini(y_dir)
      ganho       <- gini_pai - gini_filhos
      
      if(ganho > melhor_ganho) {
        melhor_ganho <- ganho
        melhor_var   <- v
        melhor_corte <- c
      }
    }
  }
  return(list(var = melhor_var, corte = melhor_corte, ganho = melhor_ganho))
}

cart_fit <- function(dados, xvars, yvar, prof = 0, prof_max = 3, min_n = 30) {
  y   <- dados[[yvar]]
  no  <- list(tipo = NULL,
              classe = classe_majoritaria(y),
              gini = gini(y),
              n = length(y),        
              dist = table(y))
  
  parar <- (length(unique(y)) == 1 || prof >= prof_max || nrow(dados) < min_n)
  
  if(parar) {
    no$tipo <- "folha"
    return(no)
  }
  
  div <- melhor_divisao(dados = dados, xvars = xvars, yvar = yvar)
  
  if(is.null(div$var) || div$ganho <= 0) {
    no$tipo <- "folha"
    return(no)
  }
  
  esq_idx <- dados[[div$var]] <= div$corte
  dir_idx <- dados[[div$var]] > div$corte 
  
  no$tipo   <- "no"
  no$var    <- div$var
  no$corte  <- div$corte
  no$ganho  <- div$ganho
  
  no$esq    <- cart_fit(dados = dados[esq_idx, ],
                        xvars = xvars,
                        yvar = yvar,
                        prof = prof + 1,
                        prof_max = prof_max,
                        min_n = min_n)
  no$dir    <- cart_fit(dados = dados[dir_idx, ],
                        xvars = xvars,
                        yvar = yvar,
                        prof = prof + 1,
                        prof_max = prof_max,
                        min_n = min_n)
  return(no)
}

pred_um <- function(arv, obs) {
  if(arv$tipo == "folha") return(arv$classe)
  if(obs[[arv$var]] <= arv$corte) {  
    return(pred_um(arv$esq, obs))   
  } else {
    return(pred_um(arv$dir, obs))   
  }
}

cart_pred <- function(arv, novos_dados) {
  preds <- character(nrow(novos_dados))
  for(i in 1:nrow(novos_dados)) {
    preds[i] <- pred_um(arv, novos_dados[i, , drop = FALSE])
  }
  return(preds)
}

# Probabilidade das folhas
pred_prob_um <- function(arv, obs) {
  if(arv$tipo == "folha") {
    if(sum(arv$dist) == 0) return(NULL)
    return(arv$dist / arv$n)
  }
  if(obs[[arv$var]] <= arv$corte) {  
    return(pred_prob_um(arv$esq, obs))   
  } else {
    return(pred_prob_um(arv$dir, obs))   
  }
}

cart_predict_proba <- function(arv, novos_dados) {
  resultados <- list()
  for(i in 1:nrow(novos_dados)) {
    prob_folha <- pred_prob_um(arv, novos_dados[i, , drop = FALSE])
    resultados[[i]] <- prob_folha
  }
  return(resultados)
}

# 5. TREINAMENTO, TESTE E AVALIAÇÃO
yvar  <- "Diabetes"
xvars <- setdiff(names(dados), c(yvar, "ID", "ano"))

set.seed(1212)
idx    <- sample(x = 1:nrow(dados), size = floor(0.7 * nrow(dados)))
treino <- dados[idx, ]
teste  <- dados[-idx, ]

# Treina o modelo principal com a base de treino
modelo_arvore_cart <- cart_fit(dados = treino, xvars = xvars, yvar = yvar, prof_max = 4, min_n = 40)

predicoes_teste <- cart_pred(modelo_arvore_cart, teste)
matriz_confusao <- table(Real = teste[[yvar]], Predito = predicoes_teste)
print(matriz_confusao)

if (all(dim(matriz_confusao) == 2)) {
  classes_reais    <- rownames(matriz_confusao)
  classes_preditas <- colnames(matriz_confusao)
  
  classe_negativa  <- classes_reais[1]
  classe_positiva  <- classes_reais[2]
  
  acuracia         <- sum(diag(matriz_confusao)) / sum(matriz_confusao)
  sensibilidade    <- matriz_confusao[classe_positiva, classe_positiva] / sum(matriz_confusao[classe_positiva, ])
  especificidade   <- matriz_confusao[classe_negativa, classe_negativa] / sum(matriz_confusao[classe_negativa, ])
  precisao         <- matriz_confusao[classe_positiva, classe_positiva] / sum(matriz_confusao[, classe_positiva])
  f1_score         <- 2 * (precisao * sensibilidade) / (precisao + sensibilidade)
  
  cat("Acurácia (Taxa Global de Acerto): ", round(acuracia * 100, 2), "%\n", sep = "")
  cat("Sensibilidade (Detectar Diabetes): ", round(sensibilidade * 100, 2), "%\n", sep="")
  cat("Especificidade (Detectar Saudáveis): ", round(especificidade * 100, 2), "%\n", sep="")
  cat("Precisão (Confiança do diagnóstico): ", round(precisao * 100, 2), "%\n", sep="")
  cat("F1-Score (Equilíbrio do modelo): ", round(f1_score * 100, 2), "%\n", sep="")
}

