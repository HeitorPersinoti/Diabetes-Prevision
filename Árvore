server <- function(input, output) {
  
  observeEvent(input$btn_calcular, {
    imc_calc <- input$Peso / (input$Altura ^ 2)
    
    classif_imc <- case_when(
      imc_calc < 18.00 ~ 1,
      imc_calc >= 18.00 & imc_calc < 25.00 ~ 2,
      imc_calc >= 25.00 & imc_calc < 30.00 ~ 3,
      imc_calc >= 30.00 & imc_calc < 35.00 ~ 4,
      imc_calc >= 35.00 & imc_calc < 40.00 ~ 5,
      imc_calc >= 40.00 ~ 6,
      TRUE ~ 0
    )
    
    novo_indiv <- dados[1, xvars, drop = FALSE]
    
    if("Idade" %in% xvars) novo_indiv$Idade <- input$Idade
    if("Peso" %in% xvars) novo_indiv$Peso <- input$Peso
    if("Altura" %in% xvars) novo_indiv$Altura <- input$Altura
    if("Pressão_Alta" %in% xvars) novo_indiv$Pressão_Alta <- as.numeric(input$Pressao_Alta)
    if("Frequencia_EF" %in% xvars) novo_indiv$Frequencia_EF <- as.numeric(input$Frequencia_EF)
    if("Estado_Saude" %in% xvars) novo_indiv$Estado_Saude <- as.numeric(input$Estado_Saude)
    if("IMC_novo" %in% xvars) novo_indiv$IMC_novo <- imc_calc
    if("Classificação" %in% xvars) novo_indiv$Classificação <- classif_imc
    
    res_prob <- cart_predict_proba(modelo_arvore_cart, novo_indiv)[[1]]
    
    prob_sim_decimal <- ifelse("1" %in% names(res_prob), res_prob[["1"]], 0)
    prob_sim_porcento <- round(prob_sim_decimal * 100, 2)
    limiar_perigo <- 25.0
    
    output$resultado_predicao <- renderText({
      if(is.null(res_prob)) {
        return("Não foi possível calcular a probabilidade para este perfil.")
      }
      
      texto <- paste0("Probabilidade estimada de possuir diabetes: ", prob_sim_porcento, "%\n\n")
      
      if(prob_sim_porcento > limiar_perigo) {
        texto <- paste0(texto, "⚠️ ATENÇÃO: A probabilidade está acima de 25%. Representa sinal de alerta e recomenda-se buscar ajuda médica para uma avaliação detalhada!")
      } else {
        texto <- paste0(texto, "✅ A probabilidade está abaixo do limite de alerta de 25%. Continue mantendo hábitos saudáveis!")
      }
      
      return(texto)
    })
    
    output$grafico_probabilidade <- renderPlot({
      req(res_prob)
      df_plot <- data.frame(
        Classe = ifelse(names(res_prob) == "1", "Sim", "Não"),
        Probabilidade = as.numeric(res_prob) * 100
      )
      
      ggplot(df_plot, aes(x = Classe, y = Probabilidade, fill = Classe)) +
        geom_col(width = 0.5, alpha = 0.8) +
        geom_hline(yintercept = limiar_perigo, color = "red", linetype = "dashed", linewidth = 1) +
        annotate("text", x = 1.5, y = limiar_perigo + 3, label = "Limite de Alerta (25%)", color = "red", fontface = "bold") +
        geom_text(aes(label = paste0(round(Probabilidade, 1), "%")), vjust = -0.5, fontface = "bold") +
        ylim(0, 105) +
        labs(title = "Risco Avaliado vs. Limiar de Alerta", x = "Diabetes", y = "Probabilidade (%)") +
        theme_minimal() +
        theme(legend.position = "none")
    })
  })
}

